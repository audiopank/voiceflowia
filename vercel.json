{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|NewPostIA-LinkPreview).*"
        }
      ],
      "destination": "/api/og?rota=home"
    },
    {
      "source": "/:rota(trial|cadastro|precos|kit-whatsapp)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|NewPostIA-LinkPreview).*"
        }
      ],
      "destination": "/api/og?rota=:rota"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/radar/cron-alerts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/reminders/cron-reengajamento",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/ffmpeg/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/trilhas/(.*).mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
