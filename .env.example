VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email do administrador que pode acessar /admin (mesmo email de login no app)
VITE_ADMIN_EMAIL=

# Server-side only (usadas pelas rotas /api/*, nao expor com prefixo VITE_)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Publicar direto no feed da NewPost-IA (rede social propria).
# A URL e a anon key sao publicas por natureza — ja vao no bundle do site da rede.
# O segredo fica na tabela newpost_contas, que so a service_role enxerga.
NEWPOST_SUPABASE_URL=
NEWPOST_SUPABASE_ANON_KEY=

# Service role do proprio VoiceFlow: as rotas /api usam pra validar a sessao do
# usuario e gravar o vinculo em newpost_contas.
SUPABASE_SERVICE_ROLE_KEY=
